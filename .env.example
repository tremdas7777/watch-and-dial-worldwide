# SagacePay (server-only; nunca use VITE_ nestas variáveis)
SAGACEPAY_API_KEY="sk_live_..."
SAGACEPAY_WEBHOOK_SECRET="..."
SAGACEPAY_POSTBACK_URL="https://seu-dominio.com/api/sagacepay/webhook"
SAGACEPAY_BASE_URL="https://sagacepay.com/api"

# Painel admin: defina uma senha forte; ela não deve ser commitada no Git.
ADMIN_PASSWORD="defina-uma-senha-forte-aqui"

# Necessário para gravar configurações e pedidos no Supabase pelo backend.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"
