# SagacePay (server-only; nunca use VITE_ nestas variáveis)
SAGACEPAY_API_KEY="sk_live_..."
SAGACEPAY_WEBHOOK_SECRET="..."
# URL HTTPS pública cadastrada na SagacePay; opcional se o webhook for configurado no painel.
SAGACEPAY_POSTBACK_URL="https://seu-dominio.com/api/sagacepay/webhook"
# Opcional para ambientes de homologação/proxy.
SAGACEPAY_BASE_URL="https://sagacepay.com/api"
